{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm run jobs:build && pnpm run auth:build && pnpm run football:tools:build",
    "start": "next start",
    "lint": "eslint",
    "jobs:build": "tsc -p tsconfig.jobs.json && node scripts/write-job-runner-entrypoint.mjs",
    "jobs:run": "node dist/job-runner/cli.js",
    "jobs:dispatch": "node dist/job-runner/dispatcher.js",
    "jobs:backfill-match-data": "node dist/job-runner/match-data-backfill.js",
    "jobs:admin-consumer": "node dist/job-runner/admin-consumer.js",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:migrations:check": "drizzle-kit check && node scripts/check-migration-state.mjs",
    "db:provision-role": "node scripts/provision-db-role.mjs",
    "db:provision-seed-role": "node scripts/provision-seed-role.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:seed:check-ddl-denied": "node scripts/seed-db.mjs --check-ddl-denied",
    "db:seed:schema-fingerprint": "node scripts/seed-db.mjs --schema-fingerprint",
    "db:check": "node --conditions react-server --import tsx scripts/check-db.ts",
    "db:jobs:check": "node --import tsx scripts/check-jobs-foundation.ts",
    "db:admin-jobs:check": "node --import tsx scripts/check-admin-jobs.ts",
    "db:football-admin-overview:check": "node --conditions react-server --import tsx scripts/check-football-admin-overview.ts",
    "db:football-admin-ui:check": "node --import tsx scripts/check-football-admin-ui.mts",
    "db:football-localization:check": "node --conditions react-server --import tsx scripts/check-football-localization.ts",
    "db:football-admin-data:check": "node --conditions react-server --import tsx scripts/check-football-admin-data.ts",
    "db:football:check": "node --import tsx scripts/check-football-foundation.ts",
    "db:football-coaches:check": "node --import tsx scripts/check-football-coaches.ts",
    "db:football-coaches:reconcile": "node --import tsx scripts/reconcile-lineup-coaches.ts",
    "db:match-dispatcher:check": "node --import tsx scripts/check-match-lifecycle-dispatcher-db.ts",
    "db:match-data-backfill:check": "node --import tsx scripts/check-match-data-backfill-db.ts",
    "db:auth:check": "node --import tsx scripts/check-auth-foundation.ts",
    "db:identity:check": "node --conditions react-server --import tsx scripts/check-identity-rbac.ts",
    "identity:provision-staff": "node --import tsx scripts/staff-auth.ts",
    "auth:build": "node scripts/build-auth-tools.mjs",
    "football:tools:build": "node scripts/build-football-tools.mjs",
    "auth:operator": "node dist/auth-tools/staff-auth.mjs",
    "config:check": "node --conditions react-server --import tsx scripts/check-runtime-config.ts",
    "api:error:check": "node --conditions react-server --import tsx scripts/check-api-errors.ts",
    "logging:check": "node --conditions react-server --import tsx scripts/check-structured-logging.ts",
    "ops:run-job:check": "node --import tsx scripts/check-run-job-wrapper.ts",
    "ops:match-dispatcher:check": "node --import tsx scripts/check-match-lifecycle-dispatcher.ts",
    "test:contracts": "pnpm run config:check && pnpm run api:error:check && pnpm run logging:check && pnpm run ai:client:check && pnpm run ops:run-job:check && pnpm run ops:match-dispatcher:check",
    "test:unit": "vitest run",
    "test:smoke": "node scripts/run-playwright-smoke.mjs",
    "test": "pnpm run test:contracts && pnpm run test:unit",
    "ai:contract:generate": "node ../scripts/generate-ai-service-contract.mjs",
    "ai:contract:check": "node ../scripts/generate-ai-service-contract.mjs --check",
    "ai:client:check": "node --conditions react-server --import tsx scripts/check-ai-service-client.ts",
    "ai:client:check:live": "node --conditions react-server --import tsx scripts/check-ai-service-live.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.10",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.32.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.23.0"
}
