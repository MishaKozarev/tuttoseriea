#!/bin/bash
set -euo pipefail

COMMAND="${SSH_ORIGINAL_COMMAND:-}"

case "$COMMAND" in
    "run-job football.sync-serie-a-foundation")
        exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-run-job-staging \
            football.sync-serie-a-foundation
        ;;
    "run-job football.sync-serie-a-matches")
        exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-run-job-staging \
            football.sync-serie-a-matches
        ;;
    "run-job football.sync-serie-a-standings")
        exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-run-job-staging \
            football.sync-serie-a-standings
        ;;
    "run-job football.sync-serie-a-squads")
        exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-run-job-staging \
            football.sync-serie-a-squads
        ;;
    "run-job football.sync-serie-a-player-statistics")
        exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-run-job-staging \
            football.sync-serie-a-player-statistics
        ;;
esac

if [[ "$COMMAND" =~ ^run-job\ (football\.sync-serie-a-match-events|football\.sync-serie-a-match-lineups|football\.sync-serie-a-match-statistics)\ --match-id\ ([0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$ ]]; then
    JOB_TYPE="${BASH_REMATCH[1]}"
    MATCH_ID="${BASH_REMATCH[2]}"

    exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-run-job-staging \
        "$JOB_TYPE" --match-id "$MATCH_ID"
fi

if [[ "$COMMAND" =~ ^(deploy|verify)\ ([0-9a-f]{40})\ (sha256:[0-9a-f]{64})(\ (sha256:[0-9a-f]{64}))?$ ]]; then
    ACTION="${BASH_REMATCH[1]}"
    GIT_SHA="${BASH_REMATCH[2]}"
    IMAGE_DIGEST="${BASH_REMATCH[3]}"
    AI_IMAGE_DIGEST="${BASH_REMATCH[5]:-}"
else
    echo "ERROR: invalid staging deployment command" >&2
    exit 1
fi

case "$ACTION" in
    deploy)
        if [[ -n "$AI_IMAGE_DIGEST" ]]; then
            exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-deploy-staging \
                "$GIT_SHA" "$IMAGE_DIGEST" "$AI_IMAGE_DIGEST"
        fi

        exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-deploy-staging \
            "$GIT_SHA" "$IMAGE_DIGEST"
        ;;
    verify)
        if [[ -n "$AI_IMAGE_DIGEST" ]]; then
            exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-verify-staging \
                "$GIT_SHA" "$IMAGE_DIGEST" "$AI_IMAGE_DIGEST"
        fi

        exec /usr/bin/sudo -n /usr/local/sbin/tuttoseriea-verify-staging \
            "$GIT_SHA" "$IMAGE_DIGEST"
        ;;
esac
