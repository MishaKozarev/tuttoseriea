#!/bin/bash
set -euo pipefail

if [[ "$#" -ne 3 ]]; then
    echo "ERROR: expected git SHA, web image digest and AI service image digest" >&2
    exit 1
fi

GIT_SHA="$1"
IMAGE_DIGEST="$2"
AI_IMAGE_DIGEST="$3"

COMPOSE_FILE="/srv/tuttoseriea/production/config/compose.yaml"
MIGRATION_ENV="/srv/tuttoseriea/production/config/migration.env"
AI_SERVICE_ENV="/srv/tuttoseriea/production/config/ai-service.env"

STAGING_VERIFIED="/srv/tuttoseriea/staging/state/verified-release"

STATE_DIR="/srv/tuttoseriea/production/state"
CURRENT_RELEASE="${STATE_DIR}/current-release"
VERIFIED_RELEASE="${STATE_DIR}/verified-release"
PREVIOUS_RELEASE="${STATE_DIR}/previous-release"

IMAGE_REPOSITORY="ghcr.io/mishakozarev/tuttoseriea/web"
AI_IMAGE_REPOSITORY="ghcr.io/mishakozarev/tuttoseriea/ai-service"
LOCK_FILE="/run/lock/tuttoseriea-production-deploy.lock"
PRODUCTION_NETWORK="tuttoseriea-production_default"

if [[ ! "$GIT_SHA" =~ ^[0-9a-f]{40}$ ]]; then
    echo "ERROR: invalid git SHA" >&2
    exit 1
fi

if [[ ! "$IMAGE_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "ERROR: invalid web image digest" >&2
    exit 1
fi

if [[ ! "$AI_IMAGE_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "ERROR: invalid AI service image digest" >&2
    exit 1
fi

REQUESTED_VALUE="${GIT_SHA} ${IMAGE_DIGEST} ${AI_IMAGE_DIGEST}"

if [[ ! -f "$MIGRATION_ENV" ]]; then
    echo "ERROR: production migration.env does not exist" >&2
    exit 1
fi

if [[ ! -f "$AI_SERVICE_ENV" ]]; then
    echo "ERROR: production ai-service.env does not exist" >&2
    exit 1
fi

read_release() {
    local file="$1"
    local label="$2"
    local -a lines

    mapfile -t lines < "$file"

    if [[ "${#lines[@]}" -ne 1 ]]; then
        echo "ERROR: invalid ${label} format" >&2
        return 1
    fi

    if [[ ! "${lines[0]}" =~ ^[0-9a-f]{40}\ sha256:[0-9a-f]{64}(\ sha256:[0-9a-f]{64})?$ ]]; then
        echo "ERROR: invalid ${label} format" >&2
        return 1
    fi

    printf '%s\n' "${lines[0]}"
}

atomic_write_release() (
    set -e

    local target="$1"
    local value="$2"
    local base
    local temp

    base="$(basename "$target")"
    temp="$(/usr/bin/mktemp "${STATE_DIR}/.${base}.XXXXXX")"

    trap '/usr/bin/rm -f "$temp"' EXIT

    printf '%s\n' "$value" > "$temp"
    /usr/bin/chmod 600 "$temp"
    /usr/bin/sync "$temp"
    /usr/bin/mv -f "$temp" "$target"
    /usr/bin/sync "$STATE_DIR"

    trap - EXIT
)

if [[ ! -f "$STAGING_VERIFIED" ]]; then
    echo "ERROR: staging verified-release does not exist" >&2
    exit 1
fi

STAGING_VALUE="$(read_release "$STAGING_VERIFIED" "staging verified-release")"

if [[ "$REQUESTED_VALUE" != "$STAGING_VALUE" ]]; then
    echo "ERROR: requested production release is not the staging verified-release" >&2
    exit 1
fi

exec 9>"$LOCK_FILE"

if ! /usr/bin/flock -n 9; then
    echo "ERROR: production deployment already in progress" >&2
    exit 1
fi

CURRENT_EXISTS=0
VERIFIED_EXISTS=0
PREVIOUS_EXISTS=0

CURRENT_VALUE=""
VERIFIED_VALUE=""
NEXT_PREVIOUS_VALUE=""

if [[ -f "$CURRENT_RELEASE" ]]; then
    CURRENT_EXISTS=1
    CURRENT_VALUE="$(read_release "$CURRENT_RELEASE" "production current-release")"
fi

if [[ -f "$VERIFIED_RELEASE" ]]; then
    VERIFIED_EXISTS=1
    VERIFIED_VALUE="$(read_release "$VERIFIED_RELEASE" "production verified-release")"
fi

if [[ -f "$PREVIOUS_RELEASE" ]]; then
    PREVIOUS_EXISTS=1
    read_release "$PREVIOUS_RELEASE" "production previous-release" >/dev/null
fi

if (( CURRENT_EXISTS == 0 && VERIFIED_EXISTS == 0 )); then
    if (( PREVIOUS_EXISTS == 1 )); then
        echo "ERROR: invalid production state: previous-release exists without current/verified" >&2
        exit 1
    fi

    echo "Production state: first deployment."

elif (( CURRENT_EXISTS == 1 && VERIFIED_EXISTS == 1 )); then
    if [[ "$CURRENT_VALUE" != "$VERIFIED_VALUE" ]]; then
        echo "ERROR: current production release is not verified; new deployment is blocked" >&2
        exit 1
    fi

    if [[ "$REQUESTED_VALUE" == "$CURRENT_VALUE" ]]; then
        echo "ERROR: requested release is already the current verified production release" >&2
        exit 1
    fi

    NEXT_PREVIOUS_VALUE="$VERIFIED_VALUE"

else
    echo "ERROR: invalid production state: current-release and verified-release are inconsistent" >&2
    exit 1
fi

WEB_IMAGE="${IMAGE_REPOSITORY}@${IMAGE_DIGEST}"
AI_SERVICE_IMAGE="${AI_IMAGE_REPOSITORY}@${AI_IMAGE_DIGEST}"
export WEB_IMAGE
export AI_SERVICE_IMAGE

echo "PRODUCTION deployment"
echo "Git SHA: ${GIT_SHA}"
echo "Web image: ${WEB_IMAGE}"
echo "AI service image: ${AI_SERVICE_IMAGE}"

/usr/bin/docker compose \
    -f "$COMPOSE_FILE" \
    config --quiet

/usr/bin/docker compose \
    -f "$COMPOSE_FILE" \
    pull

/usr/bin/docker compose \
    -f "$COMPOSE_FILE" \
    up -d postgres

echo "Waiting for PRODUCTION PostgreSQL..."

DB_READY=0

for _ in {1..30}; do
    if /usr/bin/docker compose \
        -f "$COMPOSE_FILE" \
        exec -T postgres \
        pg_isready \
        -U tuttoseriea_production \
        -d tuttoseriea_production \
        >/dev/null 2>&1; then
        DB_READY=1
        break
    fi

    sleep 2
done

if [[ "$DB_READY" -ne 1 ]]; then
    echo "ERROR: production PostgreSQL did not become ready" >&2
    exit 1
fi

echo "Applying PRODUCTION database migrations."

/usr/bin/docker run --rm \
    --network "$PRODUCTION_NETWORK" \
    --env-file "$MIGRATION_ENV" \
    "$WEB_IMAGE" \
    node scripts/migrate-db.mjs

echo "Provisioning PRODUCTION database runtime role."

/usr/bin/docker run --rm \
    --network "$PRODUCTION_NETWORK" \
    --env-file "$MIGRATION_ENV" \
    "$WEB_IMAGE" \
    node scripts/provision-db-role.mjs

echo "Updating PRODUCTION services."

/usr/bin/docker compose \
    -f "$COMPOSE_FILE" \
    up -d --remove-orphans

if [[ -n "$NEXT_PREVIOUS_VALUE" ]]; then
    atomic_write_release \
        "$PREVIOUS_RELEASE" \
        "$NEXT_PREVIOUS_VALUE"

    echo "Previous verified release recorded."
fi

atomic_write_release \
    "$CURRENT_RELEASE" \
    "$REQUESTED_VALUE"

echo "PRODUCTION containers updated."
echo "Database provisioning/migrations completed."
echo "Current release recorded."
echo "Release is NOT verified yet."
echo "Health/smoke verification is required."
