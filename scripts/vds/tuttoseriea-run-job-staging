#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "$#" -ne 1 && "$#" -ne 3 ]]; then
  printf '%s\n' "Usage: tuttoseriea-run-job-staging <job-type> [--match-id <lowercase-uuid>]" >&2
  exit 64
fi

# shellcheck source=scripts/vds/tuttoseriea-run-job-common.sh
source "/usr/local/sbin/tuttoseriea-run-job-common.sh"

run_tuttoseriea_job "staging" "tuttoseriea-staging" "$@"
