DATABASE_URL=postgresql://tuttoseriea_local_web:change-me-app-local-only@127.0.0.1:15432/tuttoseriea_local
MIGRATION_DATABASE_URL=postgresql://tuttoseriea_local:change-me-local-only@127.0.0.1:15432/tuttoseriea_local
SEED_DATABASE_URL=postgresql://tuttoseriea_local_seed:change-me-seed-local-only@127.0.0.1:15432/tuttoseriea_local
DATABASE_APP_ROLE=tuttoseriea_local_web
DATABASE_APP_PASSWORD=change-me-app-local-only
DATABASE_SEED_ROLE=tuttoseriea_local_seed
DATABASE_SEED_PASSWORD=change-me-seed-local-only
DATABASE_AUTH_SCHEMA=auth
DATABASE_IDENTITY_SCHEMA=identity
DATABASE_JOBS_SCHEMA=jobs
DATABASE_FOOTBALL_SCHEMA=football
JOB_RUNNER_LEASE_SECONDS=60
JOB_RUNNER_MAX_ATTEMPTS=3
JOB_RUNNER_RETRY_DELAY_SECONDS=60
JOB_RUNNER_RETRY_DELAY_CAP_SECONDS=300
# Consumer stays disabled in LOCAL. STAGING activation needs separate infrastructure approval.
FOOTBALL_ADMIN_CONSUMER_STAGE=
FOOTBALL_ADMIN_CONSUMER_ENABLED=false
BETTER_AUTH_SECRET=change-me-better-auth-secret-at-least-32-characters-local-only
AUTH_URL=http://localhost:3000
AUTH_WRITES_ENABLED=true
# Native Windows LOCAL: explicitly provision a separate directory and its
# .media-environment file containing "local". No automatic directory creation.
# STAGING/PRODUCTION: isolated, manually provisioned bind at /var/lib/tuttoseriea/media.
MEDIA_STORAGE_ROOT=
MEDIA_STORAGE_ENV=local
# Only configure after verifying the ingress overwrites this header.
AUTH_TRUSTED_IP_HEADER=
EMAIL_DELIVERY_MODE=local-file
RESEND_API_KEY=
RESEND_FROM=TuttoSerieA <no-reply@tuttoseriea.com>
EMAIL_ALLOWED_RECIPIENTS=
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_INTERNAL_API_KEY=change-me-local-only
API_FOOTBALL_ENABLE_REAL=false
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io/
API_FOOTBALL_TIMEOUT_MS=10000
API_FOOTBALL_KEY=
