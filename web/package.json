{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:migrations:check": "drizzle-kit check && node scripts/check-migration-state.mjs",
    "db:provision-role": "node scripts/provision-db-role.mjs",
    "db:provision-seed-role": "node scripts/provision-seed-role.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:seed:check-ddl-denied": "node scripts/seed-db.mjs --check-ddl-denied",
    "db:seed:schema-fingerprint": "node scripts/seed-db.mjs --schema-fingerprint",
    "db:check": "node --conditions react-server --import tsx scripts/check-db.ts",
    "db:auth:check": "node --import tsx scripts/check-auth-adapter.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.23.0"
}
